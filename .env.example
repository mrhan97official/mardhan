# =====================================================================
#  DevControl — cukup isi VARIABEL INTI, sisanya disiapkan otomatis
# =====================================================================
#  WAJIB
#    CF_API_TOKEN               Token Cloudflare. Izin: Account > D1 Edit,
#                               Workers R2 Storage Edit, Workers Scripts Edit,
#                               Account Analytics Read; Zone > Zone Read.
#    DEVCONTROL_ADMIN_PASSWORD  Kata sandi admin, minimal 16 karakter.
#  UNTUK FITUR DEPLOYMENT (boleh menyusul)
#    GITHUB_TOKEN, VERCEL_TOKEN
#
#  Otomatis bila dikosongkan (nilai yang Anda isi sendiri selalu dipakai):
#    CF_ACCOUNT_ID              akun satu-satunya / akun yang punya devcontrol-db
#    CF_D1_DATABASE_ID          database "devcontrol-db", dibuat bila belum ada
#    CF_R2_BUCKET               "devcontrol-<12 karakter awal account id>"
#    DEVCONTROL_SESSION_SECRET  diturunkan dari kata sandi admin + token CF
#    ZIP_ARCHIVE_ACCESS_TOKEN   memakai kata sandi admin
#    VERCEL_TEAM_ID             team pemilik project ini
#    CF_ZONE_ID                 zona yang cocok, setelah Anda konfirmasi di app
#  Jika ada keputusan yang perlu Anda ambil (mis. token punya beberapa akun
#  Cloudflare), aplikasi langsung menampilkan jendela konfirmasi setelah login.
#  Aktifkan "Automatically expose System Environment Variables" di Vercel.
# =====================================================================

CF_API_TOKEN=
DEVCONTROL_ADMIN_PASSWORD=
GITHUB_TOKEN=
VERCEL_TOKEN=

# ---------------------------------------------------------------------
#  Semua di bawah ini OPSIONAL (override manual). Penjelasan lama tetap
#  berlaku bila Anda memilih mengisinya sendiri.
# ---------------------------------------------------------------------

# Cloudflare D1 credentials used by the Go API (/api/*.go) via the D1 REST API.
# Get these from the Cloudflare dashboard:
#   - Account ID: right sidebar of any domain overview page
#   - Database ID: Workers & Pages -> D1 -> devcontrol-db -> Database ID
#   - API Token: My Profile -> API Tokens -> Create Token -> "Edit Cloudflare Workers" template (needs D1 edit permission)
# The autonomous deployment runner also needs Workers Scripts Edit. On first
# upload DevControl installs its scheduled Worker with this token. Cloudflare
# may take up to 15 minutes to activate a new schedule; the job stays queued.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# CF_API_TOKEN=  (lihat bagian WAJIB di atas)

# Optional fallback: Settings can activate real Go API metrics in one click
# without any Cloudflare zone. For full-zone traffic, Settings discovers and
# approves a matching zone; approval writes CF_ZONE_ID to Vercel and D1.
# CF_API_TOKEN needs Zone:Zone:Read and Account Analytics Read; traffic must
# pass through the Cloudflare proxy. Metrics include all hosts in the zone.
CF_ZONE_ID=

# Required for the admin dashboard and all privileged API actions.
# Use separate, strong random values (password >=16 chars, session secret >=32).
# Changing DEVCONTROL_SESSION_SECRET revokes every previously issued session.
# DEVCONTROL_ADMIN_PASSWORD=  (lihat bagian WAJIB di atas)
DEVCONTROL_SESSION_SECRET=

# One private R2 bucket for ZIP uploads, project thumbnails and pre-update snapshots. Give it a
# unique name (3-64 chars); the admin setup creates it when missing.
# CF_API_TOKEN must have Workers R2 Storage Read and Write permissions.
CF_R2_BUCKET=

# Optional for direct, uncompressed browser uploads of 4K+ project thumbnails.
# When both are blank, DevControl derives R2 S3 credentials from CF_API_TOKEN
# server-side, provided that token has R2 Object Read & Write on this bucket.
# Use a bucket-scoped R2 S3 token here if the existing token lacks that scope.
# Never put these values in client-side variables or upload them in a ZIP.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Separate secret to unlock the archive list/download on any device (>=16 chars).
# Do not place this value in client-side environment variables or source code.
ZIP_ARCHIVE_ACCESS_TOKEN=

# --- "Aplikasi Baru" / "Update Aplikasi", used by the New Deployment dropdown ---
# Both take just an app name (or an existing app) and a .zip — no repo field.
# The ZIP is stored in R2, then the Cloudflare runner tests an isolated
# Vercel project, pushes to
# GitHub, then deployed to a stable Vercel production project. Its live URL
# is saved in services.app_url for the Projects card. Both GITHUB_TOKEN
# (repo contents: write + repo creation; delete_repo/Administration write for
# the Projects delete button) and VERCEL_TOKEN are required.
# Existing D1 columns are checked and added by Databases -> Siapkan D1 + R2.
#
# --- "Update Diri" (self-update) flow, used by the same dropdown ---
# 1. Saves and extracts the uploaded .zip
# 2. Test-deploys it to Vercel as a preview build
# 3. Only if that build succeeds, the Cloudflare runner pushes the files to
#    the GitHub repo below and checks the production build. The laptop can
#    sleep after the ZIP save is confirmed; inspect Pipeline for the result.
# The same GITHUB_TOKEN also powers the repo picker (GET /api/github-repos)
# and branch picker (GET /api/github-branches) used by this form.
# VERCEL_TOKEN is a personal or team Vercel API token. The self-update test
# build always runs in a brand-new, disposable Vercel project created just
# for that one test and deleted again right after (pass or fail) — it never
# touches an existing/real project, so there's no VERCEL_PROJECT_ID to set.
# VERCEL_TEAM_ID is optional: set it if the token belongs to a team account.
# GITHUB_TOKEN=  (lihat bagian WAJIB di atas)
# VERCEL_TOKEN=  (lihat bagian WAJIB di atas)
VERCEL_TEAM_ID=
